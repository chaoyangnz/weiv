// Operation: preview directory -> Bun watcher and server driver.
import std.fs;

const source = "import { watch } from \"node:fs\";\nimport { spawnSync } from \"node:child_process\";\nimport { resolve, relative, sep } from \"node:path\";\n\nconst root = process.env.WEIV_DEV_ROOT;\nconst output = process.env.WEIV_DEV_OUT;\nconst binary = process.env.WEIV_DEV_BIN;\nconst runtime = process.env.WEIV_DEV_RUNTIME;\nif (!root || !output || !binary || !runtime) {\n  console.error(\"weiv dev info server.starting: missing development environment\");\n  process.exit(1);\n}\n\nconst relevant = /\\.(?:weiv|ts|mts|js|mjs|css|json|html)$/;\nconst ignored = (name) => {\n  if (!name) return false;\n  const absolute = resolve(root, name);\n  const path = relative(output, absolute);\n  return path === \"\" || (!path.startsWith(`..${sep}`) && path !== \"..\" && !path.startsWith(`..${sep}`));\n};\nlet timer = null;\nconst watcher = watch(root, { recursive: true }, (_event, filename) => {\n  const name = filename?.toString() ?? \"\";\n  if (!relevant.test(name) || ignored(name) || name.includes(`node_modules${sep}`) || name.includes(`${sep}.git${sep}`)) return;\n  if (timer) clearTimeout(timer);\n  timer = setTimeout(() => {\n    timer = null;\n    console.error(\"weiv dev info watch.rebuild: rebuilding\");\n    const result = spawnSync(binary, [\"--runtime-dir\", runtime, \"emit\", \"app\", root, output], {\n      env: process.env,\n      stdio: \"inherit\",\n    });\n    if (result.status === 0) {\n      console.error(\"weiv dev info watch.rebuild_complete: rebuild complete\");\n    } else {\n      console.error(\"weiv dev info watch.rebuild_blocked: rebuild blocked by diagnostics\");\n    }\n    console.error(\"weiv dev info watch.resume: watching for the next change\");\n  }, 300);\n});\n\nconsole.error(\"weiv dev info server.starting: starting Bun preview server\");\nif (process.env.PORT) {\n  console.error(`weiv dev info server.port: port=${process.env.PORT} source=env`);\n} else {\n  process.env.PORT = \"0\";\n  console.error(\"weiv dev info server.port: port=auto source=ephemeral\");\n}\nconst server = Bun.spawn([\"bun\", \"--hot\", \"server.ts\"], {\n  cwd: output,\n  env: process.env,\n  stdin: \"inherit\",\n  stdout: \"inherit\",\n  stderr: \"inherit\",\n});\nconst status = await server.exited;\nwatcher.close();\nif (timer) clearTimeout(timer);\nprocess.exit(status);\n";

pub fn write(output: string): void ! fs.FsError {
    try fs.write_file($"{output}/dev.ts", source);
    return;
}
